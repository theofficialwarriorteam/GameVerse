rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedAdmin() {
      return request.auth != null
        && request.auth.token.email == "aanjorajeev@gmail.com"
        && request.auth.token.email_verified == true;
    }
    match /site/{documentId} {
      allow read: if documentId == "public";
      allow create, update, delete: if documentId == "public" && isAuthorizedAdmin();
    }
    // Ratings and feedback are now handled by the GAMEVERSE API Worker (validation, de-duplication
    // and rate limiting). Public writes to Firestore are therefore CLOSED. These collections are
    // kept admin-only so any legacy data can still be read or deleted.
    match /ratings/{ratingId} {
      allow read, delete: if isAuthorizedAdmin();
      allow create, update: if false;
    }
    match /feedback/{feedbackId} {
      allow read, delete: if isAuthorizedAdmin();
      allow create, update: if false;
    }
  }
}
